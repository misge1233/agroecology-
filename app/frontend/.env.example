NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Map tiles (U9, D7). Empty = OpenStreetMap public tiles (development and light use only;
# see the OSM tile usage policy). For production, use a keyed provider, for example:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# Build version shown in the footer and "How to cite" (defaults to package.json).
# NEXT_PUBLIC_APP_VERSION=
