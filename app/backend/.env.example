# OpenAI — only the key goes here; model/URL are in app/services/openai_chat.py.
# Optional. With a key the chat phrases answers with the LLM and (U2) reads
# Amharic / Afaan Oromoo free text through one validated JSON extraction
# (app/services/intent_llm.py). Without it every deterministic path still
# works; am/om users are steered to the quick-reply chips / the Advisor.
OPENAI_API_KEY=

# CORS allow-list (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Raster stack location for local dev (canonical copy lives in the repo's
# geodata/layers; relative paths resolve against backend/). Docker ignores this —
# docker-compose mounts the stack at /srv/layers.
# LAYERS_DIR=../../geodata/layers

# Optional overrides
# CHAT_RATE_LIMIT_PER_MINUTE=20
# OPENAI_TIMEOUT_SECONDS=60
# DEBUG=false
