# OpenAI — only the key goes here; model/URL are in app/services/openai_chat.py.
# Optional. With a key the chat phrases answers with the LLM and (U2) reads
# Amharic / Afaan Oromoo free text through one validated JSON extraction
# (app/services/intent_llm.py). Without it every deterministic path still
# works; am/om users are steered to the quick-reply chips / the Advisor.
OPENAI_API_KEY=

# CORS allow-list (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Raster stack location for local dev (canonical copy lives in the repo's
# geodata/layers; relative paths resolve against backend/). Docker ignores this —
# docker-compose mounts the stack at /srv/layers.
# LAYERS_DIR=../../geodata/layers

# Optional overrides
# CHAT_RATE_LIMIT_PER_MINUTE=20
# OPENAI_TIMEOUT_SECONDS=60
# DEBUG=false

# Chat voice (U6). Uses OPENAI_API_KEY; the project must have access to these audio models,
# otherwise the UI falls back to the browser's own speech engines.
SPEECH_STT_MODEL=gpt-4o-mini-transcribe
SPEECH_TTS_MODEL=gpt-4o-mini-tts
SPEECH_TTS_VOICE=alloy
SPEECH_MAX_UPLOAD_MB=10

# Local voice for Amharic / Afaan Oromoo (Meta MMS, CC-BY-NC-4.0) - needs
# `pip install -r requirements-voice.txt`. Models download on first use (~145 MB per
# voice, ~3.9 GB shared recognizer) and are preferred over OpenAI for am / om.
# SPEECH_LOCAL_ENABLED=true
# SPEECH_LOCAL_LANGUAGES=am,om
# SPEECH_LOCAL_ASR=true
# SPEECH_LOCAL_PRELOAD=true
