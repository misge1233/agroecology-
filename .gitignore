# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- Node / Next.js ---
node_modules/
.next/
tsconfig.tsbuildinfo

# --- Secrets / env ---
.env
.env.local
!.env.example

# --- Large geodata (kept on disk, out of git — see geodata/README.md) ---
geodata/layers/*.tif
app/backend/layers/*.tif
*.zip

# --- Large model artifact (Zenodo/DVC at release; keep metrics in git) ---
model/artifacts/csa_model.joblib
app/backend/artifacts/csa_model.joblib

# --- Raw data too large for git (Dataverse is the source of truth) ---
data/raw/ERA_Ethiopia_dataset.csv

# --- RAG corpus (rebuilt by rag/ingest scripts) ---
rag/corpus/pdfs/*.pdf
rag/corpus/xml/*.xml
rag/corpus/manifest.jsonl.bak
rag/index/store/
rag/index/store_pre_p5a_backup/
# Tier-2 guidance bulk artifacts: rebuildable via fetch_gardian.py +
# chunk_guidance.py; manifest.jsonl stays IN git (provenance for the paper)
rag/corpus/guidance/texts/
rag/corpus/guidance/chunks.jsonl
# Knowledge-graph store: rebuilt by rag/graph/build_graph.py
rag/graph/store/
# Tier-3 WOCAT records: rebuilt by rag/ingest/wocat/normalize_wocat.py from
# the fixtures (which stay IN git) or from the owner's research data export.
# The export is CC BY-NC-SA 4.0 and is not redistributed through this repo.
rag/corpus/wocat/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp

# --- Government guideline PDFs (rebuildable from rag/corpus/guidelines/manifest.csv URLs) ---
rag/corpus/guidelines/pdfs/*.pdf
rag/corpus/guidelines/texts/

# --- Unpublished partner data and large raw inputs (never in git; see data/raw/README notes) ---
data/raw/grist_habtamu/
data/raw/catalogue/
data/raw/hotspot and coldspot/
data/raw/Typology/

# --- Unified evidence store rows (E1): built from partner data, never in git ---
data/evidence/evidence_rows.parquet
data/evidence/evidence_rows.csv
data/taxonomy/review/llm_cache.jsonl

# --- Partner catalogue text (parsed from data/raw/catalogue; not shared yet) ---
data/taxonomy/catalogue_entries.csv
data/taxonomy/catalogue_entries.json

# --- E2: caches and rebuildable mirrors (LLM caches never in git; GeoNames is downloaded once) ---
data/evidence/review/geocode_llm_cache.jsonl
pipelines/evidence/cache/
rag/corpus/guidelines/chunks.jsonl

# --- E3 geodata releases: rasters out of git; manifest.json, qa_report.json, README.md, diffs and stack.vrt stay IN git ---
geodata/*/*/*.tif
geodata/*/.*.partial/
pipelines/geodata/cache/

# --- E4: reproducible check artifacts and harness runs stay out of git; the harness query tables hold partner-derived rows ---
model/artifacts/release_check/
model/harness/runs/
data/evidence/harness/*.parquet

# --- E5: Methodology 1 v2 artifact binaries (model/m1/train.py); config.json, features.json and model_card.md stay in git ---
model/artifacts/m1_v2/*.joblib

# --- E6: Methodology 2 API answer cache, embeddings and cost ledger (prompts carry partner-derived evidence cards) ---
model/m2/cache/
